---
interface Props {
  title: string;
  slug: string;
  category: string;
  status: string;
  date: string;
  victims?: number;
  amount?: string;
  index?: number;
}

const { title, slug, category, status, date, victims, amount, index = 0 } = Astro.props;

const statusColor: Record<string, string> = {
  '진행중': 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20',
  '수사중': 'bg-amber-500/10 text-amber-400 border-amber-500/20',
  '기소완료': 'bg-blue-500/10 text-blue-400 border-blue-500/20',
  '판결확정': 'bg-purple-500/10 text-purple-400 border-purple-500/20',
};
---

<a
  href={`/cases/${slug}`}
  class="group block bg-white border border-gray-100 rounded-2xl p-6 hover:shadow-xl hover:shadow-primary/5 hover:border-accent/30 transition-all duration-300 animate-fade-up"
  style={`animation-delay: ${index * 60}ms`}
>
  <div class="flex items-start justify-between gap-4 mb-4">
    <span class="inline-flex px-3 py-1 text-xs font-medium rounded-full bg-primary/5 text-primary">
      {category}
    </span>
    <span class={`inline-flex px-3 py-1 text-xs font-medium rounded-full border ${statusColor[status] ?? 'bg-gray-100 text-gray-600'}`}>
      {status}
    </span>
  </div>

  <h3 class="text-lg font-bold text-gray-900 group-hover:text-accent transition-colors mb-3 line-clamp-2">
    {title}
  </h3>

  <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-gray-500">
    <time datetime={date}>{date}</time>
    {victims && <span>피해자 {victims.toLocaleString()}명+</span>}
    {amount && <span>피해액 {amount}</span>}
  </div>

  <div class="mt-4 flex items-center text-sm font-medium text-accent opacity-0 group-hover:opacity-100 transition-opacity">
    상세 보기
    <svg class="w-4 h-4 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
    </svg>
  </div>
</a>

<style>
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-up {
    animation: fade-up 0.5s ease-out forwards;
    opacity: 0;
  }
</style>
