        <!-- FAQ 5 -->
        <div class="faq-item rounded-xl border border-white/[0.06] overflow-hidden">
          <button class="faq-toggle w-full flex items-center justify-between px-5 py-4 text-left group" aria-expanded="false">
            <span class="text-sm font-semibold text-white group-hover:text-crimson transition-colors pr-4">{caseData.title.replace(/ 사칭.*/, '')} 사칭 사건 증거가 부족한데도 진행할 수 있나요?</span>
            <span class="faq-icon w-6 h-6 rounded-full bg-white/[0.04] border border-white/[0.08] flex items-center justify-center shrink-0 transition-transform">
              <svg class="w-3 h-3 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </span>
          </button>
          <div class="faq-answer hidden px-5 pb-5">
            <p class="text-sm text-white/40 leading-relaxed">{caseData.title.replace(/ 사칭.*/, '')} 사칭 관련 입금 기록, 문자 메시지, 카카오톡 대화 등 기본적인 자료만 있어도 시작할 수 있습니다. 전담팀이 추가 증거 수집과 디지털 포렌식을 지원하므로, 현재 보유한 자료를 기반으로 먼저 상담받으시기 바랍니다.</p>
          </div>
        </div>

        <!-- FAQ 6 -->
        <div class="faq-item rounded-xl border border-white/[0.06] overflow-hidden">
          <button class="faq-toggle w-full flex items-center justify-between px-5 py-4 text-left group" aria-expanded="false">
            <span class="text-sm font-semibold text-white group-hover:text-crimson transition-colors pr-4">{caseData.title.replace(/ 사칭.*/, '')} 사칭 상담 내용이 외부에 노출될 수 있나요?</span>
            <span class="faq-icon w-6 h-6 rounded-full bg-white/[0.04] border border-white/[0.08] flex items-center justify-center shrink-0 transition-transform">
              <svg class="w-3 h-3 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </span>
          </button>
          <div class="faq-answer hidden px-5 pb-5">
            <p class="text-sm text-white/40 leading-relaxed">{caseData.title.replace(/ 사칭.*/, '')} 사칭 관련 변호사-의뢰인 비밀유지 의무에 따라 모든 상담 내용은 철저히 보호됩니다. 가족이나 직장에 알려지는 일 없이 진행할 수 있으며, 데이터는 보안 서버에서만 관리됩니다.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom spacer for sticky bar -->
  <div class="h-16 sm:h-14"></div>

  <!-- Section 6: Footer -->
