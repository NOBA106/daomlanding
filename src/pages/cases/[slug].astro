</BaseLayout>

<script>
  // Section 2: Typing animation
  (() => {
    const el = document.getElementById('sec2-typing');
    if (!el) return;
    const phrases = [
      '사기 당한 돈, 포기하지 마세요.',
      '올바른 방법으로 대응하면',
      '골든타임 안에 움직이면',
    ];
    let phraseIdx = 0;
    let charIdx = 0;
    let deleting = false;
    const typeSpeed = 80;
    const deleteSpeed = 40;
    const pauseAfterType = 1800;
    const pauseAfterDelete = 400;

    function tick() {
      const current = phrases[phraseIdx];
      if (!deleting) {
        el!.textContent = current.slice(0, charIdx + 1);
        charIdx++;
        if (charIdx >= current.length) {
          setTimeout(() => { deleting = true; tick(); }, pauseAfterType);
          return;
        }
        setTimeout(tick, typeSpeed);
      } else {
        el!.textContent = current.slice(0, charIdx);
        charIdx--;
        if (charIdx < 0) {
          deleting = false;
          charIdx = 0;
          phraseIdx = (phraseIdx + 1) % phrases.length;
          setTimeout(tick, pauseAfterDelete);
          return;
        }
        setTimeout(tick, deleteSpeed);
      }
    }
    tick();
  })();

  // Countdown timer — 24h from first visit
  const cdH = document.getElementById('countdown-h');
  const cdM = document.getElementById('countdown-m');
  const cdS = document.getElementById('countdown-s');
  if (cdH && cdM && cdS) {
    const storageKey = 'goldentime_end';
    let endTime = localStorage.getItem(storageKey);
    if (!endTime) {
      endTime = String(Date.now() + 24 * 60 * 60 * 1000);
      localStorage.setItem(storageKey, endTime);
    }
    function updateCountdown() {
      const diff = Math.max(0, Number(endTime) - Date.now());
      const h = Math.floor(diff / 3600000);
      const m = Math.floor((diff % 3600000) / 60000);
      const s = Math.floor((diff % 60000) / 1000);
      cdH!.textContent = String(h).padStart(2, '0');
      cdM!.textContent = String(m).padStart(2, '0');
      cdS!.textContent = String(s).padStart(2, '0');
    }
    updateCountdown();
    setInterval(updateCountdown, 1000);
  }

  // Card slider — infinite auto-scroll
  const cardTrack = document.getElementById('card-track');
  if (cardTrack) {
    let scrollPos = 0;
    const speed = 0.5; // px per frame
    const totalWidth = cardTrack.scrollWidth / 2; // half = one set of 11 cards

    function animateSlider() {
      scrollPos += speed;
      if (scrollPos >= totalWidth) scrollPos = 0;
      cardTrack.style.transform = `translateX(-${scrollPos}px)`;
      requestAnimationFrame(animateSlider);
    }
    requestAnimationFrame(animateSlider);
  }

  // Typing rotation animation
  const typingEl = document.getElementById('typing-text');
  if (typingEl) {
    const texts = (typingEl.getAttribute('data-texts') || '').split('|');
    let textIndex = 0;
    let charIndex = 0;
    let isDeleting = false;

    function tick() {
      const current = texts[textIndex];
      if (!isDeleting) {
        // Typing
        typingEl!.textContent = current.slice(0, charIndex + 1);
        charIndex++;
        if (charIndex >= current.length) {
          // Pause before deleting
          isDeleting = true;
          setTimeout(tick, 2000);
          return;
        }
        setTimeout(tick, 100 + Math.random() * 60);
      } else {
        // Deleting
        typingEl!.textContent = current.slice(0, charIndex);
        charIndex--;
        if (charIndex < 0) {
          // Move to next text
          isDeleting = false;
          charIndex = 0;
          textIndex = (textIndex + 1) % texts.length;
          setTimeout(tick, 400);
          return;
        }
        setTimeout(tick, 50 + Math.random() * 40);
      }
    }
    setTimeout(tick, 600);
  }

  // Recovery answer typing animation (triggered on scroll)
  const recoveryEl = document.getElementById('recovery-typing');
  if (recoveryEl) {
    const recoveryText = '네, 되찾을 수 있습니다.';
    let recoveryStarted = false;

    function typeRecovery() {
      let i = 0;
      function step() {
        if (i <= recoveryText.length) {
          recoveryEl!.textContent = recoveryText.slice(0, i);
          i++;
          setTimeout(step, 100 + Math.random() * 60);
        } else {
          // Typing done — apply keyword-highlight neon to "되찾을 수 있습니다."
          recoveryEl!.innerHTML = '네, <span class="keyword-highlight">되찾을 수 있습니다.</span>';
        }
      }
      step();
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && !recoveryStarted) {
          recoveryStarted = true;
          setTimeout(typeRecovery, 400);
          observer.disconnect();
        }
      });
    }, { threshold: 0.5 });
    observer.observe(recoveryEl);
  }

  // Phone auto-hyphen helper
  function applyPhoneHyphen(input: HTMLInputElement) {
    const nums = input.value.replace(/\D/g, '').slice(0, 11);
    if (nums.length <= 3) {
      input.value = nums;
    } else if (nums.length <= 7) {
      input.value = nums.slice(0, 3) + '-' + nums.slice(3);
    } else {
      input.value = nums.slice(0, 3) + '-' + nums.slice(3, 7) + '-' + nums.slice(7);
    }
  }

  // Main form inputs
  const phoneInput = document.getElementById('phone') as HTMLInputElement;
  phoneInput.addEventListener('input', () => applyPhoneHyphen(phoneInput));

  function applyAmountComma(input: HTMLInputElement) {
    const nums = input.value.replace(/\D/g, '');
    input.value = nums ? Number(nums).toLocaleString('ko-KR') : '';
  }

  const amountInput = document.getElementById('amount') as HTMLInputElement;
  amountInput.addEventListener('input', () => applyAmountComma(amountInput));

  // Sticky bar inputs
  document.querySelectorAll('.sticky-input-phone').forEach((el) => {
    el.addEventListener('input', () => applyPhoneHyphen(el as HTMLInputElement));
  });
  document.querySelectorAll('.sticky-input-amount').forEach((el) => {
    el.addEventListener('input', () => applyAmountComma(el as HTMLInputElement));
  });

  // Sticky bar — always visible, no scroll logic needed

  // Live feed
  const feedData = [
    { title: '자금추적이 가능한가요', time: '오늘 · 13:14', replies: 0 },
    { title: '신용대출까지 넣었습니다', time: '1일 전 · 22:31', replies: 0 },
    { title: '전화가 안 되어서 글 남깁니다', time: '1일 전 · 13:20', replies: 3 },
    { title: '리딩방에서 당했습니다', time: '1일 전 · 10:37', replies: 3 },
    { title: '어떤 증거가 있으면 유리한가요', time: '2일 전 · 22:50', replies: 3 },
    { title: '아직 접수 가능한가요', time: '4일 전 · 19:42', replies: 0 },
    { title: '오늘 바로 상담 가능한가요', time: '4일 전 · 18:40', replies: 2 },
    { title: '서류는 뭐 준비하면 되나요', time: '4일 전 · 17:45', replies: 0 },
    { title: '핀테크 전문이라고 해서 연락드립니다', time: '5일 전 · 20:35', replies: 0 },
    { title: '출금 요청했는데 거부당했습니다', time: '5일 전 · 18:09', replies: 1 },
    { title: '아내 몰래 투자했다가 당했습니다', time: '5일 전 · 10:23', replies: 3 },
    { title: '추가 입금하라고 합니다', time: '6일 전 · 10:37', replies: 2 },
    { title: '출금하려면 돈을 더 넣으래요', time: '6일 전 · 09:45', replies: 1 },
    { title: '견적 좀 알 수 있을까요', time: '7일 전 · 15:18', replies: 3 },
    { title: '상담만 받아볼 수 있나요', time: '7일 전 · 12:03', replies: 1 },
  ];

  function createFeedItem(data: typeof feedData[0], index: number) {
    const el = document.createElement('div');
    el.className = 'py-3 px-3 rounded-lg bg-white/[0.02] border border-white/[0.04] feed-item';
    el.style.animationDelay = `${index * 0.08}s`;
    const replyBadge = data.replies > 0 ? `<span class="text-[10px] text-crimson font-bold">[${data.replies}]</span>` : '';
    el.innerHTML = `
      <div class="text-xs text-white/80 font-medium mb-1.5 leading-relaxed">
        <span class="text-emerald-400/80">[온라인 문의]</span> ${data.title} ${replyBadge}
      </div>
      <div class="text-[10px] text-white/25">${data.time}</div>
    `;
    return el;
  }

  const feed = document.getElementById('live-feed')!;
  feedData.forEach((item, i) => {
    feed.appendChild(createFeedItem(item, i));
  });

  // Match feed card height to form card height
  function matchHeight() {
    const formCard = document.getElementById('form-card');
    const feedCard = document.getElementById('feed-card');
    if (formCard && feedCard && window.innerWidth >= 1024) {
      feedCard.style.height = formCard.offsetHeight + 'px';
    } else if (feedCard) {
      feedCard.style.height = '';
    }
  }
  matchHeight();
  window.addEventListener('resize', matchHeight);


  // Form webhook submission
  const ctaForm = document.getElementById('cta-form') as HTMLFormElement;
  if (ctaForm) {
    ctaForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = ctaForm.querySelector('button[type="submit"]') as HTMLButtonElement;
      const btnText = btn.querySelector('span');
      const origText = btnText?.textContent || '';

      const fd = new FormData(ctaForm);
      const name = fd.get('name') as string;
      const phone = fd.get('phone') as string;
      const amount = fd.get('amount') as string;
      const keyword = fd.get('keyword') as string;

      btn.disabled = true;
      if (btnText) btnText.textContent = '접수 중...';

      try {
        const res = await fetch('/api/webhook', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name,
            phone,
            keyword,
            amount,
            platform: 'DAY 금융사기 피해회복 솔루션',
            partner: '데이',
          }),
        });

        if (res.ok) {
          if (btnText) btnText.textContent = '접수 완료!';
          ctaForm.reset();
          setTimeout(() => { if (btnText) btnText.textContent = origText; btn.disabled = false; }, 3000);
        } else {
          throw new Error('전송 실패');
        }
      } catch {
        if (btnText) btnText.textContent = '전송 실패 - 다시 시도해주세요';
        setTimeout(() => { if (btnText) btnText.textContent = origText; btn.disabled = false; }, 3000);
      }
    });
  }

  // FAQ accordion
  document.querySelectorAll('.faq-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item')!;
      const answer = item.querySelector('.faq-answer')!;
      const icon = btn.querySelector('.faq-icon')!;
      const isOpen = !answer.classList.contains('hidden');

      // Close all
      document.querySelectorAll('.faq-item').forEach((fi) => {
        fi.querySelector('.faq-answer')!.classList.add('hidden');
        fi.querySelector('.faq-icon')!.classList.remove('rotate-180');
        fi.querySelector('.faq-toggle')!.setAttribute('aria-expanded', 'false');
        fi.classList.remove('bg-white/[0.02]');
      });

      // Open clicked if was closed
      if (!isOpen) {
        answer.classList.remove('hidden');
        icon.classList.add('rotate-180');
        btn.setAttribute('aria-expanded', 'true');
        item.classList.add('bg-white/[0.02]');
      }
    });
  });
</script>

